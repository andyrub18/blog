# Nightly encrypted backup of the database and the uploads; see
# deploy/backup.sh and docs/DEPLOYMENT.md. Started by klea-backup.timer.
[Unit]
Description=KLEA encrypted backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/klea-backup
Nice=10
IOSchedulingClass=idle
UMask=0077
