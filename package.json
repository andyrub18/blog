{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "budget": "node scripts/measure-bundle.mjs",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed-super-admin.ts",
    "email:test": "dotenv -e .env.local -- tsx scripts/send-test-email.ts",
    "test:db": "vitest run --project=db",
    "db:seed:demo": "dotenv -e .env.local -- tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.23.2",
    "@solidjs/web": "2.0.0-rc.8",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/solid-router": "2.0.0-rc.7",
    "@tanstack/solid-start": "2.0.0-rc.7",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "nitro": "3.0.260903-beta",
    "postgres": "3.4.9",
    "resend": "6.28.0",
    "solid-js": "2.0.0-rc.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/solid-router-devtools": "2.0.0-rc.5",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
