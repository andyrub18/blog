{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx biome check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "ask": [
      "Bash(npm run db:migrate)",
      "Bash(npm run db:push)",
      "Bash(npm run db:seed)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./uploads/**)",
      "Bash(npm run db:push --force:*)"
    ]
  }
}
