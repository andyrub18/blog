# Better Auth 1.7.4 declares OPTIONAL peers solid-js@^1 and @tanstack/solid-start@^1.
# We run Solid 2 RC and Start 2 RC, and we do NOT import better-auth/solid or
# better-auth/tanstack-start/solid -- we use the framework-agnostic better-auth/client
# plus server-side auth.api.*. Remove this file once Better Auth ships Solid 2 peers.
# Every dependency is pinned to an exact version, so this does not float.
legacy-peer-deps=true
