# PostgreSQL connection string used by Drizzle and Better Auth.
# This one matches the Docker command in the README.
DATABASE_URL=postgres://klea:klea@localhost:5432/klea

# Generate with: npx -y @better-auth/cli secret
BETTER_AUTH_SECRET=replace-me

# Public base URL used to build verification links and redirects
BETTER_AUTH_URL=http://localhost:3000

# Used by `npm run db:seed` to create the Super admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-please-8chars
SUPER_ADMIN_NAME=Super Admin

# Resend transactional email. LEAVE THESE COMMENTED OUT FOR LOCAL WORK: without
# them the app prints every email — verification links included — to the
# terminal running `npm run dev`. Set, they are used for real, and a key whose
# sender is not on a domain verified in Resend makes every send fail (403).
# In production their absence is a startup failure.
# Get a key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain you have verified in Resend.
# EMAIL_FROM=KLEA <noreply@kleayiti.com>

# Cloudflare Turnstile — bot defence on registration. LEAVE COMMENTED OUT FOR
# LOCAL WORK: absent, the captcha is skipped. A placeholder value is not
# "absent" — it is checked against Cloudflare, fails, and blocks registration,
# because verification fails closed. In production their absence is a startup
# failure. Keys: https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Escape hatch for running a PRODUCTION BUILD locally without Cloudflare or
# Resend credentials (npm run build && npm start). It disables the startup
# guards and prints a loud warning. Never set it on a deployed server.
# ALLOW_INSECURE_LOCAL=true
