# PostgreSQL connection string used by Drizzle and Better Auth
DATABASE_URL=your postgres connection string here

# Generate with: npx -y @better-auth/cli secret
BETTER_AUTH_SECRET=replace-me

# Public base URL used to build verification links and redirects
BETTER_AUTH_URL=http://localhost:3000

# Used by `npm run db:seed` to create the Super admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-please-8chars
SUPER_ADMIN_NAME=Super Admin

# Resend transactional email. Without these the app prints emails to the
# console in development; in production it refuses to start.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain you have verified in Resend.
EMAIL_FROM=KLE <noreply@your-verified-domain.ht>

# Cloudflare Turnstile — bot defence on registration.
# Both absent in development disables the captcha; in production their absence
# is a startup failure. Keys: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Escape hatch for running a PRODUCTION BUILD locally without Cloudflare or
# Resend credentials (npm run build && npm start). It disables the startup
# guards and prints a loud warning. Never set it on a deployed server.
# ALLOW_INSECURE_LOCAL=true
